rules_version = '2';

// Hang Out — Firestore security rules.
// Publish via: Firebase console → Firestore Database → Rules tab → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Users: anyone signed-in can read profiles (for sender names/avatars);
    // a user may only write their own doc.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Activities: readable by any signed-in user (the discover feed).
    // Create: must be signed in and be the host. Update: host or a member
    // (e.g. join() appends to memberIds).
    match /activities/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds ||
        // Like/unlike: any signed-in user may update, but only the likedBy field
        // may change (can't tamper with other fields while liking).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
      );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    // Chats: one doc per activity (id == activityId). A signed-in user may read
    // the chat doc — needed so the client can check whether a chat exists yet
    // (ensureChat does a get() on a possibly-missing doc, where resource.data is
    // null) and to render My Activities. Membership is still enforced for
    // messages below. Create requires the creator be in the new memberIds;
    // update requires the caller be an existing or resulting member.
    match /chats/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );

      // Messages: only chat members may read; a member may create a message
      // and must be the sender.
      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(activityId)).data.memberIds;
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(activityId)).data.memberIds;
      }
    }
  }
}
